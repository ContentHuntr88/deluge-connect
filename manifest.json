{
  "manifest_version": 3,
  "name": "Deluge Connect",
  "description": "Send torrent and magnet links directly to your Deluge server.",
  "version": "0.1.0",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "permissions": [
    "contextMenus",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],

  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "Deluge Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}